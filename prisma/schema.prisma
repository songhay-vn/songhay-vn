generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  EDITOR_IN_CHIEF
  MANAGING_EDITOR
  TEAM_LEAD
  REPORTER_TRANSLATOR
  CONTRIBUTOR
}

enum EditorialStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_PUBLISH
  PUBLISHED
  REJECTED
}

enum MediaAssetType {
  IMAGE
  VIDEO
}

enum MediaAssetVisibility {
  PRIVATE
  SHARED
}

enum SearchConsoleJobType {
  URL_INSPECTION
  SITEMAP_SUBMIT
}

enum SearchConsoleJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum BioAgeGender {
  MALE
  FEMALE
}

enum BioAgeResultKey {
  YOUNGER
  BALANCED
  RECOVERY
  FAST_AGING
}

model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, action])
  @@index([role])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            UserRole       @default(CONTRIBUTOR)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  comments        Comment[]
  posts           Post[]
  approvedPosts   Post[]         @relation("PostApprover")
  lastEditedPosts Post[]         @relation("PostLastEditor")
  mediaAssets     MediaAsset[]
  postHistories   PostHistory[]  @relation("UserPostHistory")
  notifications   Notification[]
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("Subcategories", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("Subcategories")
  sortOrder   Int        @default(0)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       Post[]
}

model PenName {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  avatarUrl      String?
  avatarPublicId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posts          Post[]

  @@index([name])
}

model Post {
  id                    String                   @id @default(cuid())
  title                 String
  slug                  String                   @unique
  excerpt               String
  content               String
  penName               String?
  penNameId             String?
  thumbnailUrl          String?
  videoEmbedUrl         String?
  seoTitle              String?
  seoDescription        String?
  seoKeywords           String?
  ogImage               String?
  isSensitive           Boolean                  @default(false)
  isDraft               Boolean                  @default(true)
  isFeatured            Boolean                  @default(false)
  featuredPosition      Int?                     @unique
  isTrending            Boolean                  @default(false)
  isPublished           Boolean                  @default(false)
  editorialStatus       EditorialStatus          @default(DRAFT)
  isDeleted             Boolean                  @default(false)
  deletedAt             DateTime?
  approvedAt            DateTime?
  publishedAt           DateTime                 @default(now())
  scheduledPublishAt    DateTime?
  canonicalUrl          String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  categoryId            String
  authorId              String?
  approverId            String?
  lastEditorId          String?
  category              Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  penNameProfile        PenName?                 @relation(fields: [penNameId], references: [id], onDelete: SetNull)
  author                User?                    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  approver              User?                    @relation("PostApprover", fields: [approverId], references: [id], onDelete: SetNull)
  lastEditor            User?                    @relation("PostLastEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  comments              Comment[]
  history               PostHistory[]
  seoKeywordLinks       PostSeoKeyword[]
  notifications         Notification[]
  searchConsoleStatuses SearchConsoleUrlStatus[]
  searchConsoleJobs     SearchConsoleJob[]

  @@index([categoryId])
  @@index([penNameId])
  @@index([authorId])
  @@index([approverId])
  @@index([lastEditorId])
  @@index([isDraft])
  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([editorialStatus])
  @@index([isDeleted, isPublished, isDraft, publishedAt(sort: Desc)])
  @@index([categoryId, isDeleted, isPublished, publishedAt(sort: Desc)])
  @@index([editorialStatus, isDeleted, publishedAt(sort: Desc)])
  @@index([authorId, editorialStatus])
}

model SearchConsoleUrlStatus {
  id                   String    @id @default(cuid())
  postId               String
  url                  String
  verdict              String?
  coverageState        String?
  robotsTxtState       String?
  indexingState        String?
  pageFetchState       String?
  lastCrawlTime        DateTime?
  googleCanonical      String?
  userCanonical        String?
  inspectionResultLink String?
  richResultsVerdict   String?
  rawResult            Json?
  lastError            String?
  checkedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, url])
  @@index([postId])
  @@index([verdict])
  @@index([checkedAt])
}

model SearchConsoleJob {
  id         String                 @id @default(cuid())
  type       SearchConsoleJobType
  status     SearchConsoleJobStatus @default(PENDING)
  postId     String?
  url        String
  dedupeKey  String                 @unique
  attempts   Int                    @default(0)
  runAfter   DateTime               @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  response   Json?
  lastError  String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([type, createdAt])
  @@index([postId])
}

model BioAgeSubmission {
  id              String          @id @default(cuid())
  sessionId       String          @unique
  age             Int
  gender          BioAgeGender
  score           Int
  resultKey       BioAgeResultKey
  estimatedMinAge Int
  estimatedMaxAge Int?
  sourcePath      String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([createdAt])
  @@index([age])
  @@index([gender])
  @@index([resultKey])
}

model MediaAsset {
  id          String               @id @default(cuid())
  publicId    String?
  assetType   MediaAssetType
  visibility  MediaAssetVisibility @default(SHARED)
  url         String
  displayName String?
  filename    String
  mimeType    String
  sizeBytes   Int
  uploadedAt  DateTime             @default(now())
  uploaderId  String
  uploader    User                 @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId, assetType])
  @@index([visibility, assetType])
  @@index([uploadedAt])
}

model Comment {
  id                     String   @id @default(cuid())
  authorName             String
  content                String
  isApproved             Boolean  @default(false)
  containsBlockedKeyword Boolean  @default(false)
  createdAt              DateTime @default(now())
  postId                 String
  post                   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId               String?
  author                 User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([authorId])
  @@index([isApproved, containsBlockedKeyword])
  @@index([postId, isApproved])
}

model SeoKeyword {
  id                String           @id @default(cuid())
  keyword           String
  normalizedKeyword String           @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  postLinks         PostSeoKeyword[]

  @@index([keyword])
}

model PostSeoKeyword {
  postId       String
  seoKeywordId String
  createdAt    DateTime   @default(now())
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  seoKeyword   SeoKeyword @relation(fields: [seoKeywordId], references: [id], onDelete: Cascade)

  @@id([postId, seoKeywordId])
  @@index([seoKeywordId])
}

model ForbiddenKeyword {
  id             String   @id @default(cuid())
  term           String
  normalizedTerm String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([term])
}

model PostHistory {
  id              String           @id @default(cuid())
  postId          String
  actorId         String
  actionType      String
  fromStatus      EditorialStatus?
  toStatus        EditorialStatus?
  snapshotTitle   String?
  snapshotExcerpt String?
  snapshotContent String?
  createdAt       DateTime         @default(now())

  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  actor User @relation("UserPostHistory", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([postId, createdAt])
  @@index([actorId])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  postId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([postId])
}
